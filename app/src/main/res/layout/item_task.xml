<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:checkable="true"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="30dp"
        app:contentPaddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardTask"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/colorAccent"
                    app:cardCornerRadius="25dp">

                    <ImageView
                        android:id="@+id/imgTaskBell"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Image"
                        android:focusable="true"
                        android:src="@drawable/ic_bell" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/tvTaskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="8dp"
                    android:layout_toEndOf="@+id/cardTask"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="title"
                    android:textColor="@color/black"
                    android:textSize="22sp" />


                <TextView
                    android:id="@+id/tvTaskCreatedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTaskTitle"
                    android:layout_marginStart="25dp"
                    android:layout_toEndOf="@+id/cardTask"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:text="8 Nov"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEvent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:backgroundTint="@color/colorAccent"

                    app:cardCornerRadius="25dp">

                    <ImageView
                        android:id="@+id/imgTaskType"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Image"
                        android:src="@drawable/ic_task_everyday" />
                </androidx.cardview.widget.CardView>


                <TextView
                    android:id="@+id/tvTaskDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/tvTaskCreatedDate"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:fontFamily="@font/regular"
                    android:text="Believe you can and you’re halfway there."
                    android:textColor="@color/gray"
                    android:textSize="13sp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/tvTaskDetails"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:foreground="@color/foreground_blur"

                    app:cardCornerRadius="20dp">

                    <ImageView
                        android:id="@+id/imgAddTask"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_below="@+id/tvTaskDetails"
                        android:contentDescription="Image"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_man"
                        android:visibility="visible" />

                </androidx.cardview.widget.CardView>


                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapTask"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_below="@+id/tvTaskDetails"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:foreground="@color/foreground_blur"
                    android:visibility="gone" />


            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIsMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/colorAccent"
                    android:focusable="true"
                    android:fontFamily="@font/regular"
                    android:gravity="center|start"
                    android:text="@string/open_map"
                    android:textColor="@color/gray"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:theme="@style/Nav.NavigationDrawer" />


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/tvTaskTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:drawableStart="@drawable/ic_icons_dark_time"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/colorAccent"
                        android:fontFamily="@font/regular"
                        android:gravity="center"
                        android:text=" 19:00 — 21:00"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTaskDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="7dp"
                        android:layout_toEndOf="@+id/tvTaskTime"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/colorAccent"
                        android:fontFamily="@font/regular"
                        android:gravity="center"
                        android:text=" Today - 15 Nov"
                        android:textColor="@color/gray"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/imgTaskDelete"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Image"
                        android:focusable="true"
                        android:src="@drawable/ic_bin" />
                </RelativeLayout>


            </LinearLayout>


        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>


</RelativeLayout>

