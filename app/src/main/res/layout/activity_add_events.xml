<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:are="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark">


        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|enterAlwaysCollapsed">


            <androidx.appcompat.widget.Toolbar
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@drawable/sh_toolbar"
                android:backgroundTint="@color/colorPrimary"
                app:popupTheme="@style/AppTheme.AppBarOverlay" />

            <ImageView
                android:id="@+id/imgArrowBackEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|top"
                android:layout_marginStart="10dp"
                android:background="@drawable/sh_ripple"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_icons_light_arrow_back" />

            <com.github.clans.fab.FloatingActionButton
                android:id="@+id/fabBellEvent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_gravity="end"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:cropToPadding="true"
                android:src="@drawable/ic_bell"
                app:elevation="10dp"
                app:fabCustomSize="50dp"
                app:fab_colorNormal="@color/colorAccent"
                app:fab_colorPressed="@color/purple_dark"
                app:fab_progress_showBackground="true"
                app:fab_showAnimation="@anim/fab_scale_up"
                app:fab_showShadow="true"
                app:useCompatPadding="true" />


        </com.google.android.material.appbar.CollapsingToolbarLayout>


    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="16dp"
            android:background="@color/colorPrimaryDark"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/sh_corner"
                android:clickable="true"
                android:drawablePadding="3dp"
                android:drawableTint="@color/white"
                android:focusable="true"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:padding="5dp"
                android:text="@string/title"
                android:textColor="@color/white"
                android:textSize="16sp" />


            <EditText
                android:id="@+id/etTitleEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:alpha="0.9"
                android:autofillHints="title"
                android:background="@drawable/sh_item_corner"
                android:backgroundTint="@color/white"
                android:fontFamily="@font/bold"
                android:gravity="start|center"
                android:inputType="text"
                android:maxLines="1"
                android:padding="10dp"
                android:textColor="@color/black"
                android:textCursorDrawable="@null"
                android:textDirection="locale"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/sh_corner"
                android:clickable="true"
                android:drawableStart="@drawable/ic_details"
                android:drawablePadding="3dp"
                android:drawableTint="@color/white"
                android:focusable="true"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="@string/description"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:theme="@style/SelectableItemTheme"
                app:cardBackgroundColor="@color/colorPrimary_light"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"

                >

                <EditText
                    android:id="@+id/etDetailsEvent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:background="@color/white"
                    android:fontFamily="@font/regular"
                    android:gravity="top"
                    android:hint="@string/more_details"
                    android:lines="6"
                    android:padding="16dp"
                    android:textColor="@color/black"
                    android:textCursorDrawable="@null"
                    android:textDirection="locale"
                    android:textSize="18sp" />
            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/tvMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/sh_corner"
                android:drawableStart="@drawable/ic_photo"
                android:drawablePadding="3dp"
                android:drawableTint="@color/white"
                android:fontFamily="@font/bold"
                android:gravity="center"
                android:text="@string/photo"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:theme="@style/SelectableItemTheme"
                    app:cardBackgroundColor="@color/colorPrimary_light"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"

                    >

                    <ImageView
                        android:id="@+id/imgAddEvent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tvTaskDetails"
                        android:layout_gravity="center"
                        android:adjustViewBounds="true"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:contentDescription="Image"
                        android:focusable="true"
                        android:foreground="@color/foreground_blur"
                        android:scaleType="fitCenter"
                        android:visibility="visible" />

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/carAddE"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.9"
                    android:clickable="true"
                    android:focusable="true"
                    android:theme="@style/SelectableItemTheme"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp">

                    <ImageView
                        android:id="@+id/imgAddE"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="@color/foreground_blur"
                        android:src="@drawable/ic_add_pic" />
                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sh_corner"
                    android:drawableStart="@drawable/ic_location"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="@string/map"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <com.google.android.gms.maps.MapView
                    android:id="@+id/mapEvent"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:foreground="@color/foreground_blur"
                    android:visibility="visible" />


            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="16dp"
                android:gravity="start"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/sh_corner"
                    android:drawableStart="@drawable/ic_icons_dark_user"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="@string/persons"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvAddPersons"
                    style="@style/SelectableItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_add"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/white"
                    android:focusable="true"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="6dp"
                    android:text="@string/add_persons"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:listitem="@layout/item_contacts_event" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="22dp"
                    android:layout_marginTop="8dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/regular"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:textColor="@color/white_light"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_contacts_event" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/sh_corner"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="@string/date"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvStartDate"
                        style="@style/SelectableItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableTint="@color/white"
                        android:focusable="true"
                        android:fontFamily="@font/regular"
                        android:foreground="@drawable/sh_border"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="@string/start_date"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:layout_weight="0.2"
                        android:gravity="center"
                        android:text="|"
                        android:textColor="@color/white_light" />

                    <TextView
                        android:id="@+id/tvEndDate"
                        style="@style/SelectableItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableTint="@color/white"
                        android:focusable="true"
                        android:fontFamily="@font/regular"
                        android:foreground="@drawable/sh_border"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="@string/end_date"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="14sp" />

                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/sh_corner"
                    android:drawableStart="@drawable/ic_icons_dark_time"
                    android:drawablePadding="3dp"
                    android:drawableTint="@color/white"
                    android:fontFamily="@font/bold"
                    android:gravity="center"
                    android:text="@string/time"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:theme="@style/Theme.AppCompat.Light">

                    <TextView
                        android:id="@+id/tvStartTime"
                        style="@style/SelectableItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableTint="@color/white"
                        android:focusable="true"
                        android:fontFamily="@font/regular"
                        android:foreground="@drawable/sh_border"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="@string/start_time"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="5dp"
                        android:layout_weight="0.2"
                        android:gravity="center"
                        android:text="|"
                        android:textColor="@color/white_light" />

                    <TextView
                        android:id="@+id/tvEndTime"
                        style="@style/SelectableItemBackground"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="8dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:drawableTint="@color/white"
                        android:focusable="true"
                        android:fontFamily="@font/regular"
                        android:foreground="@drawable/sh_border"
                        android:gravity="center"
                        android:padding="6dp"
                        android:text="@string/end_time"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="14sp" />

                </LinearLayout>


                <RelativeLayout
                    android:id="@+id/containerReminder"
                    style="@style/SelectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="22dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/sh_border"
                    android:padding="10dp"


                    >

                    <ImageView
                        android:id="@+id/imgArrowRepeat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_expand_left"
                        android:tint="@color/white_light" />

                    <TextView
                        android:id="@+id/tvRemind"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic_repeat"
                        android:drawablePadding="3dp"
                        android:drawableTint="@color/white"
                        android:fontFamily="@font/bold"
                        android:gravity="center"
                        android:text="@string/reminder"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvReminderEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_toStartOf="@+id/imgArrowRepeat"
                        android:layout_toEndOf="@+id/tvRemind"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/regular"
                        android:gravity="center"
                        android:text="@string/before_10_min"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="12sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/containerRingtone"
                    style="@style/SelectableItemBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="22dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="@drawable/sh_border"
                    android:padding="10dp"

                    >

                    <ImageView
                        android:id="@+id/imgArrowRingTone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_expand_left"
                        android:tint="@color/white_light" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_gravity="center"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic_bell_icon"
                        android:drawablePadding="3dp"
                        android:drawableTint="@color/white"
                        android:fontFamily="@font/bold"
                        android:gravity="center"
                        android:text="@string/ringtone"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRingtoneEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_toStartOf="@+id/imgArrowRingTone"
                        android:fontFamily="@font/regular"
                        android:gravity="center"
                        android:text="@string/notification_ringtone"
                        android:textColor="@color/white_light"
                        android:textDirection="locale"
                        android:textSize="12sp" />

                </RelativeLayout>


            </LinearLayout>

            <Button
                android:id="@+id/btnEventSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="27dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/sh_btn_corner"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/regular"
                android:padding="16dp"
                android:text="@string/add_event"
                android:textColor="@color/white" />


        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

